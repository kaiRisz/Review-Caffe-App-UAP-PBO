<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #E8D9C7;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminDashboardController">
    <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
    <children>
      <AnchorPane prefHeight="137.0" prefWidth="712.0">
         <children>
              <Label layoutX="337.0" layoutY="14.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #41230C;" text="Admin Dashboard" />
                <Button fx:id="addCafeButton" layoutX="202.0" layoutY="69.0" onAction="#handleAddCafe" prefHeight="30.0" prefWidth="88.0" style="-fx-background-color: #0F7840; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 12;" text="Add Cafe" />
                <Button fx:id="editCafeButton" disable="true" layoutX="310.0" layoutY="69.0" onAction="#handleEditCafe" prefHeight="30.0" prefWidth="88.0" style="-fx-background-color: #F0A400; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 12;" text="Edit Cafe" />
                <Button fx:id="deleteCafeButton" disable="true" layoutX="420.0" layoutY="69.0" onAction="#handleDeleteCafe" prefHeight="30.0" prefWidth="88.0" style="-fx-background-color: #F00000; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 12;" text="Delete Cafe" />
                <Button fx:id="viewReviewsButton" layoutX="527.0" layoutY="69.0" onAction="#handleViewReviews" style="-fx-background-color: #0019FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 12;" text="View All Reviews" />
         </children>
      </AnchorPane>

        <TableView fx:id="cafesTable" style="-fx-margin-top: 15; -fx-table-cell-border-color: transparent; -fx-background-color: #ECAE7E;">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="180" text="Name" />
                <TableColumn fx:id="locationColumn" prefWidth="220" text="Location" />
                <TableColumn fx:id="descriptionColumn" prefWidth="250" text="Description" />
            </columns>
        </TableView>
    </children>
</VBox>

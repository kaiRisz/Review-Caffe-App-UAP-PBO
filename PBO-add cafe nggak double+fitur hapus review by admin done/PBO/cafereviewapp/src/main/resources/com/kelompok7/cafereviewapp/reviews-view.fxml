<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="10" style="-fx-background-color: #E8D9C7;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ReviewsViewController">

    <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>

    <children>
      <AnchorPane prefHeight="200.0" prefWidth="785.0">
         <children>
      
              <Label layoutX="384.0" layoutY="14.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #41230C;" text="All Reviews" />
               <Label layoutX="92.0" layoutY="71.0" text="Filter by Cafe:" />
   
               <Label layoutX="333.0" layoutY="71.0" text="Start Date:" />
               <DatePicker fx:id="startDatePicker" layoutX="333.0" layoutY="98.0" />
   
               <Label layoutX="597.0" layoutY="71.0" text="End Date:" />
               <DatePicker fx:id="endDatePicker" layoutX="604.0" layoutY="98.0" />
               <ComboBox fx:id="cafeFilterCombo" layoutX="92.0" layoutY="98.0" prefWidth="150" />
               <Button fx:id="deleteReviewButton" layoutX="362.0" layoutY="152.0" onAction="#handleDeleteReview" style="-fx-background-color: #F00000; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 12;" text="Delete Selected Review" />
               <Button layoutX="673.0" layoutY="152.0" onAction="#handleResetFilter" prefHeight="26.0" prefWidth="94.0" style="-fx-background-color: #F0A400; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 12;" text="Reset" />
   
               <Button layoutX="92.0" layoutY="152.0" onAction="#handleFilter" prefHeight="26.0" prefWidth="129.0" style="-fx-background-color: #0F7840; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 12;" text="Apply Filter" />
         </children>
      </AnchorPane>

        <!-- TABLE -->
        <TableView fx:id="reviewsTable" prefHeight="298.0" prefWidth="874.0" style="-fx-background-color: #ECAE7E;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" prefWidth="50" text="ID" />
                <TableColumn fx:id="cafeCol" prefWidth="150" text="Cafe" />
                <TableColumn fx:id="userCol" prefWidth="100" text="User" />
                <TableColumn fx:id="ratingCol" prefWidth="70" text="Rating" />
                <TableColumn fx:id="commentCol" prefWidth="250" text="Comment" />
                <TableColumn fx:id="dateCol" prefWidth="150" text="Date" />
            </columns>
        </TableView>
      <AnchorPane prefHeight="30.0" prefWidth="874.0">
         <children>
            <Button fx:id="backButton" layoutX="195.0" layoutY="-4.0" mnemonicParsing="false" onAction="#handleBack" prefHeight="34.0" prefWidth="484.0" style="-fx-background-color: #6A3105; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 12;" text="Back" />
         </children>
         <VBox.margin>
            <Insets bottom="10.0" top="10.0" />
         </VBox.margin>
      </AnchorPane>

    </children>
</VBox>
